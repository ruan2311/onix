<?xml version="1.0" encoding="utf-8"?>
<!--
  Onix Controle: app de celular que vira controle remoto de uma Google TV, pelo protocolo de
  controle da própria TV (o mesmo do app Google TV), na rede de casa. INTERNET é usada para falar
  com a TV e para procurar versões novas no GitHub.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.onix.controle"
    android:versionCode="2"
    android:versionName="1.0.1">

    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Atualizações pelo próprio app (o Android sempre pede confirmação na tela). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="Onix Controle"
        android:icon="@mipmap/icon"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name="com.onix.controle.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name="com.onix.controle.UpdateReceiver"
            android:exported="false" />
    </application>
</manifest>
